# Copy to .env.local and fill in. Never commit .env.local — .gitignore covers it.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Project Settings → API. The anon key is safe to expose; RLS is the boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — used by the seed/reset endpoint, never sent to
# the browser. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── LLM ────────────────────────────────────────────────────────────────────
# gemini | groq | canned. `canned` runs the app with no network calls at all,
# which is the demo-day fallback if a free tier runs dry.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Evals point at Groq to protect the Gemini daily quota.
GROQ_API_KEY=
